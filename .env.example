# demo 无需任何密钥。live 不会自动降级为 demo。
AGENT_MODE=demo
# LLM_BASE_URL 必须是支持 Chat Completions 和工具调用的 API 根地址
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
NOTION_TOKEN=
# 普通父页面 ID；不要填 database/data source ID
NOTION_PARENT_PAGE_ID=
# 可选：按服务商真实单价填写美元/百万 Token，否则成本显示未配置
INPUT_PRICE_PER_MILLION=0
OUTPUT_PRICE_PER_MILLION=0
